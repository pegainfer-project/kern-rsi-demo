#!/usr/bin/env bash
# loop/check BUNDLE OUT [BASE]: the numerics gate. kern test of a bundle against BASE (default
# main's, state/main/bundle) under the GPU lease: every changed call replayed from main's inputs,
# the end-to-end logits, prefill over every chunk size, and the noise floor, at as long a prompt
# as the card holds (~200 tokens on 16 GB, the served 8k on a large card). Writes OUT.json and
# OUT.log; the last line is the verdict, PASS / FAIL / INCONCLUSIVE (exit 0 / 1 / 2).
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/env.sh"
cand=$(realpath "$1") out=$(realpath -m "$2") base=$(realpath "${3:-$STATE/main/bundle}")
work=$out.d
rm -rf "$work" && mkdir -p "$work/kernels"
cp "$base"/kernels/*.cubin "$work/kernels/"
# kern test diffs ops, not cubins: a module rebuilt under the same name would read as nothing to
# test. Renamed in the candidate, every op on a changed module is a changed implementation.
python3 - "$base/model.json" "$cand" "$work" <<'PY'
import json, shutil, sys
from pathlib import Path
base, cand, work = json.load(open(sys.argv[1])), Path(sys.argv[2]), Path(sys.argv[3])
m = json.load(open(cand / "model.json"))
changed = {k for k, v in m["modules"].items() if base["modules"].get(k, {}).get("sha256") != v["sha256"]}
for k in changed:
    shutil.copy(cand / "kernels" / m["modules"][k]["source"], work / "kernels" / f"{k}+candidate.cubin")
    m["modules"][k]["source"] = f"{k}+candidate.cubin"
m["modules"] = {(k + "+candidate" if k in changed else k): v for k, v in m["modules"].items()}
for op in m["ops"].values():
    for launch in op["impl"].get("launches", []):
        if launch.get("module") in changed:
            launch["module"] += "+candidate"
json.dump(m, open(work / "model.json", "w"))
print("modules changed:", ", ".join(sorted(changed)) or "none")
PY
# kern test holds every run's state and every span's outputs on the GPU. On Qwen3-4B its peak
# was the weights less 1 GiB, plus ~30 KV rows per token of capacity and ~152 per prefill token
# (GB300: 14.6 GB at 1024 / 214, 47.3 GB at 2048 / 1546), so the card's memory sets both, up to
# the served context.
read -r capacity prefill <<<"$(python3 - "$base/model.json" "$WEIGHTS" \
  "$(nvidia-smi -i "$GPU" --query-gpu=memory.total --format=csv,noheader,nounits)" <<'PY'
import json, sys
from pathlib import Path
m, weights, total = json.load(open(sys.argv[1])), Path(sys.argv[2]), int(sys.argv[3]) * 2**20
row = sum(s["bytes_per_token"] for s in m["states"].values())
budget = total - 600 * 2**20 - (sum(f.stat().st_size for f in weights.glob("*.safetensors")) - 2**30)
cap = max(1024, min(8192, budget // 2 // (30 * row) // 1024 * 1024))
prefill = max(16, min(cap - 64, (budget - 30 * row * cap) // (152 * row) // 16 * 16))
print(cap, prefill)
PY
)"
"$LOOP/withgpu" "$KERN" test --capacity "$capacity" --prefill "$prefill" --reference "$base/model.json" --manifest "$work/model.json" \
  --kernels "$work/kernels" --weights "$WEIGHTS" --tokenizer "$WEIGHTS/tokenizer.json" --gpu 0 \
  --out "$out.json" > "$out.log" 2>&1
rc=$?
grep -E "logit|KL|flip|noise" "$out.log" | tail -6
tail -n 1 "$out.log"
exit $rc
